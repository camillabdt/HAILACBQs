{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HAILA: Testes",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pytest",
        "backend/tests",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA: Ablação C1-C3",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "evaluation/run_ablation.py",
        "--base-url",
        "http://127.0.0.1:8010",
        "--conditions",
        "C1_LLM",
        "C2_RAG_LLM",
        "C3_RAG_LLM_SLM",
        "--specs",
        "evaluation/pilot_specifications.jsonl",
        "--out",
        "evaluation/results/ablation-vscode.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA: Ablação C4",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "evaluation/run_c4_pilot.py",
        "--base-url",
        "http://127.0.0.1:8010",
        "--specs",
        "evaluation/pilot_specifications.jsonl",
        "--out",
        "evaluation/results/ablation-vscode-c4.json",
        "--run-id",
        "ablation-vscode-c4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA: Consolidar tokens exatos",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "evaluation/summarize_token_usage.py",
        "evaluation/results/ablation-vscode.json",
        "evaluation/results/ablation-vscode-c4.json",
        "--out",
        "evaluation/results/ablation-vscode-token-usage.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA: Consolidar experimento atual",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "evaluation/summarize_token_usage.py",
        "evaluation/results/ablation-cost-exact-c1.json",
        "evaluation/results/ablation-cost-exact-c1-retry.json",
        "evaluation/results/ablation-cost-exact-c1-p05-final.json",
        "evaluation/results/ablation-cost-exact-c2.json",
        "evaluation/results/ablation-cost-exact-c2-p04-final.json",
        "evaluation/results/ablation-cost-exact-c3.json",
        "evaluation/results/ablation-cost-exact-c4.json",
        "evaluation/results/ablation-cost-exact-c4-remainder.json",
        "--out",
        "evaluation/results/ablation-cost-exact-summary.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA LoRA ★ Montar dataset completo (ENADE + POSCOMP)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "research/lora/montar_dataset.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA LoRA 0a: Baixar provas do GitHub (geacc/enade)",
      "type": "shell",
      "command": "git clone --depth 1 https://github.com/geacc/enade.git ../geacc-enade || git -C ../geacc-enade pull",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA LoRA 0b: Copiar provas para enade/",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "research/lora/importar_geacc.py",
        "../geacc-enade",
        "enade/"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA LoRA 0c: Baixar PDFs listados em enade/links.txt (opcional)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "research/lora/baixar_enade.py",
        "enade/links.txt",
        "enade/"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA LoRA 1: Extrair questões do ENADE",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "research/lora/extrair_enade.py",
        "enade/",
        "dados/questoes.jsonl"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA LoRA ★★ Teste rápido (5 passos)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "research/lora/treinar_tudo.py",
        "--teste-rapido"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTORCH_ENABLE_MPS_FALLBACK": "1",
          "TOKENIZERS_PARALLELISM": "false"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "HAILA LoRA ★★★ Treinar e comparar",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "research/lora/treinar_tudo.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTORCH_ENABLE_MPS_FALLBACK": "1",
          "TOKENIZERS_PARALLELISM": "false"
        }
      },
      "problemMatcher": []
    }
  ]
}